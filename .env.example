# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Chave secreta: nunca compartilhe e nunca use em código do navegador
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://barbudos-cup.vercel.app

# Envio de e-mails (ex.: Brevo SMTP — smtp-relay.brevo.com, porta 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="Barbudos Cup <seu-email@exemplo.com>"
